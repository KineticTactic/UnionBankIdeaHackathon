# =============================================================================
# PCOP — Predictive Customer Outreach Platform
# Root .env.example — every variable for every service, grouped.
# Copy to .env and fill in.  A fresh clone + this file = working system.
# =============================================================================

# ── Bank API (Layer 1) ───────────────────────────────────────────────────────
BANK_PORT=3001
BANK_DATA_DIR=./bank/data
# Used by the bank container to optionally persist new customers via Postgres.
BANK_DATABASE_URL=

# ── Express Orchestrator (server) ────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
JWT_SECRET=change-this-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=8h
DEMO_MODE=true
# Comma-separated CORS origins; * allows everything (fine for local dev).
CORS_ORIGINS=*
# If true, the in-process Kafka simulation is enabled (no broker needed).
ENABLE_KAFKA_SIMULATION=true
# Max concurrent LLM generations.
LLM_MAX_CONCURRENCY=5

# ── Bank / Chronos upstream endpoints (orchestrator → upstream) ──────────────
BANK_API_BASE_URL=http://localhost:3001
CHRONOS_BASE_URL=http://localhost:8001
ARGUS_BASE_URL=http://localhost:8002
COMPASS_BASE_URL=http://localhost:8004
HERALD_BASE_URL=http://localhost:8005
VERDICT_BASE_URL=http://localhost:8006
ORACLE_BASE_URL=http://localhost:8007

# ── Postgres (churn_scores, signals, audit_log, consent, etc.) ───────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pcop
POSTGRES_USER=pcop
POSTGRES_PASSWORD=pcop_dev
DATABASE_URL=postgresql://pcop:pcop_dev@localhost:5432/pcop

# ── Redis (BullMQ + event-bus) ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Kafka (real broker; if unreachable, simulation fallback engages) ─────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=pcop-intelligence-server
KAFKA_GROUP_ID=pcop-consumers

# ── MLflow (CHRONOS / ORACLE) ────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Groq LLM (HERALD + COMPASS + analysis + call-analysis) ───────────────────
# OpenAI-compatible Chat Completions API.  Server-side only; never expose the
# key to the client.  Without GROQ_API_KEY the platform falls back to
# cached/template content.
# Get a key at https://console.groq.com/keys
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=45000
GROQ_REASONING_EFFORT=low

# ── Layer 3 · CHRONOS ────────────────────────────────────────────────────────
CHRONOS_PORT=8001
CHRONOS_CORS_ORIGINS=*
CHRONOS_CHECKPOINT_DIR=./L3_CHRONOS/ml/checkpoints
CHRONOS_DATABASE_URL=postgresql://pcop:pcop_dev@localhost:5432/pcop
CHRONOS_REDIS_URL=redis://localhost:6379
CHRONOS_KAFKA_BROKERS=localhost:9092
CHRONOS_LOG_LEVEL=INFO

# ── Layer 2 · ARGUS ──────────────────────────────────────────────────────────
ARGUS_PORT=8002
ARGUS_DEMO_MODE=true
ARGUS_CORS_ORIGINS=*
ARGUS_LOG_LEVEL=INFO

# ── Layer 4 · COMPASS ────────────────────────────────────────────────────────
COMPASS_PORT=8004
COMPASS_DEMO_MODE=true
COMPASS_CORS_ORIGINS=*
COMPASS_LOG_LEVEL=INFO

# ── Layer 5 · HERALD ─────────────────────────────────────────────────────────
HERALD_PORT=8005
HERALD_DEMO_MODE=true
HERALD_CORS_ORIGINS=*
HERALD_LOG_LEVEL=INFO

# ── Layer 6 · VERDICT ────────────────────────────────────────────────────────
VERDICT_PORT=8006
VERDICT_DEMO_MODE=true
VERDICT_CORS_ORIGINS=*
VERDICT_LOG_LEVEL=INFO
VERDICT_DATABASE_URL=postgresql://pcop:pcop_dev@localhost:5432/pcop

# ── Layer 7 · ORACLE ─────────────────────────────────────────────────────────
ORACLE_PORT=8007
ORACLE_DEMO_MODE=true
ORACLE_CORS_ORIGINS=*
ORACLE_LOG_LEVEL=INFO
ORACLE_DATABASE_URL=postgresql://pcop:pcop_dev@localhost:5432/pcop

# ── Next.js Client ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
CLIENT_PORT=3000

# ── Resend (transactional email, used by /api/outreach/send-email) ───────────
# Get a key at https://resend.com/api-keys
# Default sender is the Resend sandbox (onboarding@resend.dev) which only
# delivers to the account owner — set RESEND_SANDBOX_OVERRIDE=false to
# honour the customer's real email in production.
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM=onboarding@resend.dev
RESEND_SANDBOX_OVERRIDE=true

# ── Twilio WhatsApp (used by /api/outreach/send-whatsapp) ────────────────────
# Get credentials at https://console.twilio.com/
# Default `from` is the Twilio sandbox number.  The recipient must have
# joined the sandbox by texting the join keyword.  Set
# WA_SANDBOX_OVERRIDE=false to honour the customer's real phone in production.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WA_SANDBOX_OVERRIDE_TO=whatsapp:+919874618487
WA_SANDBOX_OVERRIDE=true
