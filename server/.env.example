# ── Mode ──────────────────────────────────────────────────────────────────────
# Set to "false" to enable Postgres + Redis (production mode).
# Leave unset or "true" for in-memory demo (Railway live demo).
DEMO_MODE=true

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:3000

# ── Postgres (required when DEMO_MODE=false) ──────────────────────────────────
DATABASE_URL=postgresql://pcop:pcop_dev@localhost:5432/pcop

# ── Redis (required when DEMO_MODE=false) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── CHRONOS ML scoring service ────────────────────────────────────────────────
CHRONOS_BASE_URL=http://localhost:8001

# ── Bank API ──────────────────────────────────────────────────────────────────
BANK_API_BASE_URL=http://localhost:3001

# ── Groq LLM (HERALD outreach + call analysis + optional translation) ───────
# OpenAI-compatible Chat Completions API.  The key is server-side only.
# Without GROQ_API_KEY the platform falls back to cached/template content.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=45000
# gpt-oss models reason before answering; "low" keeps the completion content
# from being crowded out.  Set empty to omit the parameter for non-reasoning models.
GROQ_REASONING_EFFORT=low
# Optional overrides:
# GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# GROQ_MAX_CONCURRENCY=5

# ── Anthropic (fallback) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-sonnet-20240229
USE_CLAUDE_FALLBACK=true

# ── SSE cap (per Node process) ────────────────────────────────────────────────
MAX_SSE_PER_NODE=1000

# ── Resend (transactional email, used by /api/outreach/send-email) ───────────
# Get a key at https://resend.com/api-keys
# Default sender is the Resend sandbox (onboarding@resend.dev) which only
# delivers to the account owner — set RESEND_SANDBOX_OVERRIDE=false to
# honour the customer's real email in production.
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM=onboarding@resend.dev
RESEND_SANDBOX_OVERRIDE=true

# ── Twilio WhatsApp (used by /api/outreach/send-whatsapp) ────────────────────
# Get credentials at https://console.twilio.com/
# Default `from` is the Twilio sandbox number.  The recipient must have
# joined the sandbox by texting the join keyword.  Set
# WA_SANDBOX_OVERRIDE=false to honour the customer's real phone in production.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WA_SANDBOX_OVERRIDE_TO=whatsapp:+919874618487
WA_SANDBOX_OVERRIDE=true
