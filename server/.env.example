# ── Mode ──────────────────────────────────────────────────────────────────────
# Set to "false" to enable Postgres + Redis (production mode).
# Leave unset or "true" for in-memory demo (Railway live demo).
DEMO_MODE=true

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:3000

# ── Postgres (required when DEMO_MODE=false) ──────────────────────────────────
DATABASE_URL=postgresql://pcop:pcop_dev@localhost:5432/pcop

# ── Redis (required when DEMO_MODE=false) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── CHRONOS ML scoring service ────────────────────────────────────────────────
CHRONOS_BASE_URL=http://localhost:8001

# ── Bank API ──────────────────────────────────────────────────────────────────
BANK_API_BASE_URL=http://localhost:3001

# ── NVIDIA DeepSeek (HERALD + COMPASS + analysis + call-analysis LLM) ────────
NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro

# ── Anthropic (fallback) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-sonnet-20240229
USE_CLAUDE_FALLBACK=true

# ── SSE cap (per Node process) ────────────────────────────────────────────────
MAX_SSE_PER_NODE=1000

# ── Resend (transactional email, used by /api/outreach/send-email) ───────────
# Get a key at https://resend.com/api-keys
# Default sender is the Resend sandbox (onboarding@resend.dev) which only
# delivers to the account owner — set RESEND_SANDBOX_OVERRIDE=false to
# honour the customer's real email in production.
RESEND_API_KEY=re_LL2L4P2m_JSwpUNnMqUCSgQcYMX9r9K4i
RESEND_FROM=onboarding@resend.dev
RESEND_SANDBOX_OVERRIDE=true
